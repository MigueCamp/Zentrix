<network-security-config>
    <!-- Solo para desarrollo local: backend vía HTTP en el emulador (10.0.2.2 = host).
         En staging/prod el backend se sirve por HTTPS y esta excepción no aplica. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

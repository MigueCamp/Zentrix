# =============================================================================
# Zentrix — Plantilla de variables de entorno (docs/06_Despliegue_y_DevOps.md §4)
# =============================================================================
# Copia este archivo como `.env` por ambiente y complétalo con valores reales.
# NUNCA versiones un `.env` con secretos reales: solo esta plantilla vive en git.
# En staging/producción estos valores se inyectan como secretos del "environment"
# de GitHub / del orquestador, no desde un archivo en disco.

# --- Perfil activo ----------------------------------------------------------
# dev | staging | prod  (selecciona application-<perfil>.yml)
SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080

# --- Base de datos SQL Server -----------------------------------------------
DB_HOST=sqlserver.internal.example.com
DB_PORT=1433
DB_NAME=zentrix
DB_USER=zentrix_app
DB_PASSWORD=__CAMBIAR__

# --- Seguridad de la aplicación ---------------------------------------------
# Secreto de firma JWT (largo y aleatorio). Genera uno con:
#   openssl rand -base64 48
ZENTRIX_JWT_SECRET=__CAMBIAR__
# Minutos de expiración por defecto del JWT (las empresas pueden sobrescribirlo).
ZENTRIX_JWT_EXPIRATION_MINUTES=30
# Clave AES-256 (Base64, 32 bytes) para cifrar ConfiguracionJson WiFi/VPN. Genera con:
#   openssl rand -base64 32
ZENTRIX_ENCRYPTION_KEY=__CAMBIAR__
# Orígenes permitidos para CORS (la URL real de la consola web, separadas por coma).
ZENTRIX_CORS_ALLOWED_ORIGINS=https://consola.example.com

# --- Almacenamiento de APKs -------------------------------------------------
# Ruta/volumen persistente donde se guardan los APKs subidos.
ZENTRIX_APK_DIR=/var/lib/zentrix/apks

# --- Usuario SUPER_ADMIN de arranque ----------------------------------------
# Dejar VACÍO en staging/prod salvo durante el arranque inicial único; luego
# limpiar estas variables para no recrear el usuario en cada despliegue.
ZENTRIX_BOOTSTRAP_ADMIN_EMAIL=
ZENTRIX_BOOTSTRAP_ADMIN_PASSWORD=

# --- Notificaciones push (FCM) ----------------------------------------------
# Credencial del servicio de mensajería para el push de comandos al dispositivo.
# (El agente hoy usa polling; esta clave habilita el push cuando se active.)
FCM_CREDENTIALS_JSON=__CAMBIAR__

# --- Frontend (build-time) --------------------------------------------------
# URL pública del backend que consume la consola web (se fija al construir la imagen).
NEXT_PUBLIC_API_URL=https://api.example.com
